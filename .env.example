# ============================================
# Finora Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# --------------------------------------------
# Google Analytics (optional)
# Get this from https://analytics.google.com
# --------------------------------------------
VITE_GA_ID=G-XXXXXXXXXX

# --------------------------------------------
# Google AdSense (optional)
# Get this from https://www.google.com/adsense
# --------------------------------------------
VITE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# --------------------------------------------
# Gemini API Key (optional)
# Get this from https://aistudio.google.com/app/apikey
# --------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------
# App environment: development | production | test
# --------------------------------------------
VITE_APP_ENV=development

# ============================================
# Lovable deployment notes:
# 1) Add these variables in Lovable Project Settings > Environment Variables
# 2) Re-publish after changing environment variables
# ============================================
