# ============================================
# Finora Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# --------------------------------------------
# Google Analytics (필수 아님 - 선택사항)
# https://analytics.google.com 에서 발급 가능
# --------------------------------------------
VITE_GA_ID=G-XXXXXXXXXX

# --------------------------------------------
# Google AdSense (필수 아님 - 선택사항)
# https://www.google.com/adsense 에서 발급 가능
# --------------------------------------------
VITE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# --------------------------------------------
# Gemini API Key (필수 아님 - 선택사항)
# https://aistudio.google.com/app/apikey 에서 발급 가능
# 현재는 사용되지 않음 (향후 AI 기능 확장용)
# --------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------
# 앱 환경 설정
# development | production | test
# --------------------------------------------
VITE_APP_ENV=development

# ============================================
# Vercel 배포 시 설정 방법:
# 1. Vercel Dashboard → Project Settings → Environment Variables
# 2. 위 변수들을 추가 (VITE_ 접두사 필수)
# 3. Redeploy 실행
# ============================================
