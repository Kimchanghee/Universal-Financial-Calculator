# ============================================
# Finora Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# --------------------------------------------
# Google Analytics (optional)
# Get this from https://analytics.google.com
# --------------------------------------------
VITE_GA_ID=G-XXXXXXXXXX

# --------------------------------------------
# Google AdSense (optional)
# Get this from https://www.google.com/adsense
# --------------------------------------------
VITE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_AD_SLOT_TOP=0000000000
VITE_AD_SLOT_BODY=0000000000
VITE_AD_SLOT_FOOTER=0000000000
VITE_AD_SLOT_SIDEBAR_LEFT=0000000000
VITE_AD_SLOT_SIDEBAR_RIGHT=0000000000

# Optional reporting channels (create in AdSense to compare slot RPM/viewability)
VITE_AD_CHANNEL_TOP=
VITE_AD_CHANNEL_BODY=
VITE_AD_CHANNEL_FOOTER=
VITE_AD_CHANNEL_SIDEBAR_LEFT=
VITE_AD_CHANNEL_SIDEBAR_RIGHT=

# Ad optimization runtime controls
# true/false: use page-level Auto ads in parallel with manual slots
VITE_AD_ENABLE_AUTO_ADS=true
# true/false: use responsive ad format for top/body/footer slots
VITE_AD_ENABLE_RESPONSIVE=true
# IntersectionObserver rootMargin for lazy ad loading
VITE_AD_LAZY_MARGIN=300px
# Set 'on' only for local testing (never keep on in production)
VITE_AD_TEST_MODE=

# --------------------------------------------
# Gemini API Key (optional)
# Get this from https://aistudio.google.com/app/apikey
# --------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------
# App environment: development | production | test
# --------------------------------------------
VITE_APP_ENV=development

# ============================================
# Lovable deployment notes:
# 1) Add these variables in Lovable Project Settings > Environment Variables
# 2) Re-publish after changing environment variables
# ============================================
